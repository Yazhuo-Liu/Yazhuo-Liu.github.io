<i class="bi bi-list mobile-nav-toggle d-xl-none" aria-label="Toggle navigation"></i>

<header id="header">
  <div class="d-flex flex-column">
    <div class="profile">
      <img src="/{{ site.images.profile }}" alt="Portrait of {{ site.name }}" class="img-fluid rounded-circle">
      <h1 class="text-light"><a href="/">{{ site.name }}</a></h1>
      <div class="social-links mt-3 text-center">
        {% for social in site.socials %}
        <a href="{{ social.url }}" class="{{ social.className }}" aria-label="{{ social.name }}" target="_blank" rel="noopener noreferrer"><i class="{{ social.icon }}" aria-hidden="true"></i></a>
        {% endfor %}
      </div>
    </div>

    <nav id="navbar" class="nav-menu navbar" aria-label="Primary navigation">
      <ul>
        <li><a href="/#hero" class="nav-link scrollto{% if activeNav == 'home' %} active{% endif %}"><i class="bx bx-home"></i> <span>Home</span></a></li>
        <li><a href="/#about" class="nav-link scrollto"><i class="bx bx-user"></i> <span>About</span></a></li>
        <li><a href="/#resume" class="nav-link scrollto"><i class="bx bx-file-blank"></i> <span>Resume</span></a></li>
        <li><a href="/{{ site.cv }}" class="nav-link" target="_blank" rel="noopener noreferrer"><i class="bx bx-server"></i> <span>Download Resume</span></a></li>
        <li><a href="/#portfolio" class="nav-link scrollto"><i class="bx bx-book-content"></i> <span>Gallery</span></a></li>
        <li><a href="/#writings" class="nav-link scrollto{% if activeNav == 'writings' %} active{% endif %}"><i class="bx bx-pen"></i> <span>Writings & Blogs</span></a></li>
        <li><a href="/music/" class="nav-link{% if activeNav == 'music' %} active{% endif %}"><i class="bx bx-music"></i> <span>My Songs</span></a></li>
        <li><a href="/#contact" class="nav-link scrollto"><i class="bx bx-envelope"></i> <span>Contact</span></a></li>
      </ul>
    </nav>
  </div>
</header>
